{
    "compilerOptions": {
        "target": "ES2022",
        "module": "CommonJS",
        "rootDir": "./src",
        "outDir": "./dist",

        "strict": true,

        "esModuleInterop": true,
        "allowSyntheticDefaultImports": true,

        "skipLibCheck": true,

        "forceConsistentCasingInFileNames": true,

        "sourceMap": true
    },
    "include": [
        "src/**/*.ts"
    ],
    "exclude": [
        "node_modules",
        "dist"
    ]
}